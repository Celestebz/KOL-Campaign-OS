[Unit]
Description=KOL Campaign OS
After=network-online.target mysqld.service
Wants=network-online.target
Requires=mysqld.service

[Service]
Type=simple
User=kolapp
Group=kolapp
WorkingDirectory=/opt/kol-campaign-os/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/kol-campaign-os/kol-campaign-os.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kol-campaign-os

[Install]
WantedBy=multi-user.target
